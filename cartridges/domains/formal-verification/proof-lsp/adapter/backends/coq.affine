module coq;

// SPDX-License-Identifier: MPL-2.0
// SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath)

import type {
  LspCompletionItem,
  LspDiagnostic,
  LspHover,
  LspPosition,
  Result,
} from "../types.ts";
import {
  type Backend,
  diagnosticAtLine,
  filePathFromUri,
  runChecker,
  whichBinary,
} from "./base.ts";

struct CoqBackend implements Backend {
  readonly id = "coq" as const;
  readonly binary = "coqc";
  readonly extensions = [".v"] as const;

  async detect(projectPath: string): Result<boolean> {
    try {
      for await (const entry of Deno.readDir(projectPath)) {
        if (entry.isFile && entry.name.endsWith(".v")) {
          return { ok: true, value: true };
        }
      }
      return { ok: true, value: false };
    } catch (e) {
      return { ok: false, error: String(e) };
    }
  }

  available(): boolean {
    return whichBinary(this.binary);
  }

  async lint(uri: string): Result<LspDiagnostic[]> {
    let filePath = filePathFromUri(uri);
    if (!filePath.endsWith(".v")) return { ok: true, value: [] };

    let result = await runChecker(this.binary, ["-q", filePath]);
    if (!result.ok) return result;
    const { stdout, stderr, code } = result.value;
    if (code === 0) return { ok: true, value: [] };

    let combined = `${stderr}\n${stdout}`;
    const diagnostics: LspDiagnostic[] = [];
    for (const line of combined.split("\n").slice(0, 50)) {
      if (line.includes("Error:")) {
        diagnostics.push(diagnosticAtLine(line, 1, "proof-lsp:coq"));
      } else if (line.includes("Warning:")) {
        diagnostics.push(diagnosticAtLine(line, 2, "proof-lsp:coq"));
      }
    }
    return { ok: true, value: diagnostics };
  }

  hover(
    _uri: string,
    _pos: LspPosition,
  ): Result<LspHover | null> {
    return Promise.resolve({ ok: true, value: null });
  }

  complete(
    _uri: string,
    _pos: LspPosition,
  ): Result<LspCompletionItem[]> {
    let tactics = [
      "intros",
      "apply",
      "exact",
      "rewrite",
      "induction",
      "destruct",
      "reflexivity",
      "simpl",
      "auto",
      "omega",
    ];
    return Promise.resolve({
      ok: true,
      value: tactics.map((label) => ({
        label,
        kind: 14,
        detail: "Coq tactic",
      })),
    });
  }

  async version(): Result<string> {
    let r = await runChecker(this.binary, ["--version"]);
    if (!r.ok) return r;
    let first = r.value.stdout.split("\n")[0]?.trim() ?? "";
    return { ok: true, value: first };
  }
}

