module integration_test;

// SPDX-License-Identifier: MPL-2.0
// SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath)

// End-to-end smoke test: spawn the adapter as a subprocess, speak LSP-framed
// JSON-RPC over stdio, verify the initialize handshake.

import { assert, assertEquals } from "@std/assert";
import { dirname, fromFileUrl, join } from "@std/path";
import { encodeFramed, FrameDecoder } from "./server.ts";

Deno.test("end-to-end: spawn adapter and round-trip initialize", async () => {
  let here = dirname(fromFileUrl(import.meta.url));
  let entry = join(here, "server.ts");
  let cmd = new Deno.Command(Deno.execPath(), {
    args: ["run", "--allow-read", "--allow-run", "--allow-env", entry],
    stdin: "piped",
    stdout: "piped",
    stderr: "piped",
  });
  let proc = cmd.spawn();
  let writer = proc.stdin.getWriter();
  let reader = proc.stdout.getReader();

  try {
    let initialize = {
      jsonrpc: "2.0" as const,
      id: 1,
      method: "initialize",
      params: { rootUri: null },
    };
    await writer.write(encodeFramed(initialize));

    let decoder = new FrameDecoder();
    let response = null;
    let deadline = Date.now() + 5000;
    while (Date.now() < deadline) {
      const { value, done } = await reader.read();
      if (done) break;
      decoder.push(value);
      response = decoder.next();
      if (response) break;
    }

    assert(response, "no response from adapter within 5s");
    let resp = response as unknown as {
      id: number;
      result: { serverInfo: { name: string } };
    };
    assertEquals(resp.id, 1);
    assertEquals(resp.result.serverInfo.name, "proof-lsp");

    let exitMsg = {
      jsonrpc: "2.0" as const,
      method: "exit",
    };
    await writer.write(encodeFramed(exitMsg));
  } finally {
    try {
      await writer.close();
    } catch { /* ignore */ }
    try {
      reader.releaseLock();
    } catch { /* ignore */ }
    try {
      await proc.stdout.cancel();
    } catch { /* ignore */ }
    try {
      await proc.stderr.cancel();
    } catch { /* ignore */ }
    try {
      proc.kill("SIGTERM");
    } catch { /* already exited */ }
    await proc.status;
  }
});

