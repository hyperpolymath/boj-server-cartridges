// Domain types for stack-orchestrator-mcp.
// Direct port of the implicit Elixir map shapes in
// polystack/poly-orchestrator-lsp/lib/orchestrator/{stack_parser,planner}.ex.

struct StackMetadata {
  name: string;
  version: string;
  description?: string;
  author?: string;
}

struct Component {
  id: string;
  type: string;
  lsp_server: string;
  depends_on?: string[];
  phase?: number;
  config?: Record<string, unknown>;
}

struct SecuritySection {
  threat_model?: string;
  attack_surface_score?: number;
  validated?: boolean;
  policies?: string[];
  constraints?: string[];
}

struct Orchestration {
  max_parallel?: number;
  timeout_ms?: number;
  retry_count?: number;
  variables?: Record<string, string>;
}

struct Rollback {
  enabled?: boolean;
  strategy?: string;
  preserve_data?: boolean;
  triggers?: Record<string, unknown>;
}

struct VerificationStep {
  name?: string;
  command?: string;
  [key: string]: unknown;
}

struct Stack {
  metadata: StackMetadata;
  components: Component[];
  security?: SecuritySection;
  orchestration?: Orchestration;
  rollback?: Rollback;
  verification?: VerificationStep[];
}

struct SecurityPolicies {
  threat_model: string | undefined;
  attack_surface_score: number | undefined;
  validated: boolean;
  policies: string[];
  constraints: string[];
}

struct ComponentStep {
  id: string;
  type: string;
  lsp_server: string;
  config: Record<string, unknown>;
  depends_on: string[];
  outputs: Record<string, unknown>;
  status: "pending" | "running" | "succeeded" | "failed" | "rolled_back";
}

struct Phase {
  phase: number;
  parallel: string[][];
  components: ComponentStep[];
}

struct RollbackStrategy {
  enabled: boolean;
  strategy: string;
  preserve_data: boolean;
  triggers: Record<string, unknown>;
}

struct ExecutionPlan {
  stack_id: string;
  phases: Phase[];
  security_policies: SecurityPolicies;
  rollback_strategy: RollbackStrategy;
  verification: VerificationStep[];
}

type Result<T, E = string> = { ok: true; value: T } | { ok: false; error: E };

fn ok<T>(value: T): Result<T, never> {
  return { ok: true, value };
}

fn err<E>(error: E): Result<never, E> {
  return { ok: false, error };
}

