---
### [AI_MANIFEST]
description: |
  Canonical home of BoJ cartridges. Hosts (boj-server, panll, others)
  fetch cartridges from here on-demand into a flat host-local cache at
  BOJ_CARTRIDGES_PATH. This repository ships the source tree, the pinned
  schema mirror, and the validator that guards both.

  SOLE SOURCE since 2026-08-04. hyperpolymath/boj-server#300 ("feat!:
  retire the bundled cartridges/ tree") merged that day and deleted
  boj-server's own cartridges/ directory. No host carries a fallback copy
  any more, so a bad merge to main here reaches every host on its next
  fetch. Verified 2026-08-07: boj-server's cartridges/ path returns 404 on
  its default branch and scripts/fetch-cartridges.sh is present.

role: "registry"
canonical_for: "BoJ cartridge manifests"

canonical_locations:
  cartridges: "cartridges/"
  schema: "schemas/cartridge-v1.json"
  schema_pin: "schemas/PINNED-SHA"
  schema_doc: "schemas/SCHEMA-MIRROR.md"
  validator: "tools/validate-cartridges/"
  minter: "tools/cartridge-minter/mint.ts"
  foundry: "tools/foundry/foundry.sh"
  minting_template: "cartridges/templates/gossamer-mcp/"
  shim_canon: "cartridges/templates/gossamer-mcp/ffi/cartridge_shim.zig"
  proof_gate: "scripts/typecheck-proofs.sh"
  trusted_base_gate: "scripts/check-trusted-base.sh"
  audits: "audits/"
  taxonomy_adr: "docs/decisions/ADR-001-taxonomy.adoc"
  checkpoints: ".machine_readable/6a2/"
  contractiles: ".machine_readable/contractiles/"

upstream:
  schema_canonical: "hyperpolymath/standards@cartridges/cartridge-v1.json"
  schema_canonical_commit: "7c2b81556791e97172da866b560147ec541797eb"
  schema_canonical_commit_drift: |
    KNOWN DISAGREEMENT. schemas/PINNED-SHA records
    canonical_commit = "f5f0506a6ec88e574753eee701a268e0d4b3a7f2"
    (pinned_at 2026-07-01, pinned_by_pr standards#373), which is not the
    commit named above. PINNED-SHA is the OPERATIVE record — the CI gate
    verifies the mirror's content SHA-256 against it, and that check
    passes. The field above was not updated when the pin moved. Reconcile
    it, or delete it in favour of PINNED-SHA; do not assume it is current.

downstream_consumers:
  - id: "boj-server"
    role: "runtime"
    fetcher_script: "scripts/fetch-cartridges.sh"
    catalog_module: "elixir/lib/boj_rest/catalog.ex"
    bundled_tree: "retired 2026-08-04 (boj-server#300)"
  - id: "panll"
    role: "host"
    verified: false
    note: "Listed from this repository's own records. Not independently verified against the panll tree."

taxonomy:
  layout: "hybrid"
  domains_root: "cartridges/domains/<domain>/<name>"
  cross_cutting_root: "cartridges/cross-cutting/<category>/<name>"
  templates_root: "cartridges/templates/<name>"

role_suffixes:
  - mcp
  - lsp
  - dap
  - bsp
  - debug
  - format
  - lint
  - build
  - nesy
  - agentic
  - fleet

trust_tiers:
  - id: "Teranga"
    description: "Core / always-available"
  - id: "Shield"
    description: "Security-critical / elevated-trust"
  - id: "Ayo"
    description: "Community-contributed"

---
