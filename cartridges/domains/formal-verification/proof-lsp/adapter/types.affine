type Result<T, E = string> =
  | { ok: true; value: T }
  | { ok: false; error: E };

let ok = <T>(value: T): Result<T, never> => ({ ok: true, value });
let err = <E>(error: E): Result<never, E> => ({ ok: false, error });

struct BackendId { "coq" | "lean" | "isabelle" | "agda";

struct LspPosition {
  line: number;
  character: number;
}

struct LspRange {
  start: LspPosition;
  end: LspPosition;
}

struct LspDiagnostic {
  range: LspRange;
  severity: 1 | 2 | 3 | 4;
  source: string;
  message: string;
}

struct LspHover {
  contents: { kind: "markdown" | "plaintext"; value: string };
  range?: LspRange;
}

struct LspCompletionItem {
  label: string;
  kind?: number;
  detail?: string;
  documentation?: string;
}

struct JsonRpcRequest {
  jsonrpc: "2.0";
  id: number | string;
  method: string;
  params?: unknown;
}

struct JsonRpcNotification {
  jsonrpc: "2.0";
  method: string;
  params?: unknown;
}

struct JsonRpcResponse {
  jsonrpc: "2.0";
  id: number | string | null;
  result?: unknown;
  error?: { code: number; message: string; data?: unknown };
}

struct JsonRpcMessage { JsonRpcRequest | JsonRpcNotification;

