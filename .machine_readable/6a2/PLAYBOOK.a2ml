#
# PLAYBOOK.a2ml — Operational playbook
# Runbooks and standing procedures for boj-server-cartridges.
#
# ---------------------------------------------------------------------------
# CORRECTION NOTICE — 2026-08-07
#
# A global find/replace of "v" -> "zig" corrupted the previous version of this
# file. It read as though ZIG were the banned language, in a repository whose
# FFI and adapter layers are entirely Zig. Corrupted strings included
# "# === Banned: ziguage ===" (was "vlanguage"), "after zig removed",
# "chore/remove-zig  Purge zig remnants", "check-no-vlang.sh  zig ban
# validator" and "feedback_v_lang_banned  zig ban".
#
# THE FACTS, restored:
#   * The banned language is V (vlang.io). Banned estate-wide 2026-04-10.
#   * Zig is V's REPLACEMENT, not its casualty. Zig is required here.
#   * The same corruption hit ~140 cartridge READMEs; fixed in the same
#     branch as this file (docs/machine-readable-repair).
# ---------------------------------------------------------------------------

[metadata]
version = "0.2.0"
last-updated = "2026-08-07"

[deployment]
method = "none — this repository is not deployed"
notes = """
boj-server-cartridges publishes nothing and runs nothing. It is a git tree
that hosts read. There is no artefact, no image, no package.

Two workflows do push bytes outward and are the closest thing to a release:
  * .github/workflows/mirror.yml      mirrors the repo to other git forges
  * .github/workflows/pages.yml and pages-deploy.yml  publish site/ to
    GitHub Pages and Cloudflare Pages

There is no Containerfile in this repo. The Justfile's container-* recipes
are inherited RSR template scaffolding and are not exercised.
"""

# ===========================================================================
# CORE OPERATIONS
# ===========================================================================

[op-mint-a-cartridge]
purpose = "Scaffold a new cartridge from the canonical template."
template = "cartridges/templates/gossamer-mcp/"
steps = """
 1. Write a minter.toml (format: tools/cartridge-minter/README.md).
 2. deno run --allow-read --allow-write tools/cartridge-minter/mint.ts \\
      path/to/minter.toml [--dest <override>]
    With no --dest the destination is derived from minter.toml:
      category = "domain"         -> cartridges/domains/<domain>/<name>/
      category = "cross-cutting"  -> cartridges/cross-cutting/<sub>/<name>/
      category = "template"       -> cartridges/templates/<name>/
 3. The name MUST end in a canonical role suffix (mcp, lsp, dap, bsp, debug,
    format, lint, build, nesy, agentic, fleet) or the schema gate rejects it.
 4. Run the schema gate (see [op-schema-gate]) before committing.
"""
higher-assurance-path = "tools/foundry/foundry.sh runs the proven mint -> provision -> configure -> harness flow modelled in tools/foundry/proof/Foundry.idr. Use --strict in CI so a missing deno/idris2/jq is a FAILURE, not a skip."
caveat = """
INHERITED DEFECT — a freshly minted cartridge does NOT build its adapter.
The template adapter calls ffi.gossamer_init, which does not exist, and the
ffi `export fn` declarations are not `pub`, so the adapter cannot import
them. All 99 adapter/build.zig trees share this fault and no CI job catches
it (see [known-gaps]). Do not treat `mint` output as green.
"""
recipe-note = "There is no `just mint` recipe on main. One is proposed in open PR #109."

[op-schema-gate]
purpose = "Validate every cartridge.json against the pinned schema. This is the repo's primary hard gate."
run = """
  cd tools/validate-cartridges
  deno task audit    # human-readable report, exit 0 regardless
  deno task strict   # non-zero exit on any violation — this is what CI runs
  deno task test     # validator unit tests
"""
workflow = ".github/workflows/cartridge-schema.yml"
mode = "strict since 2026-06-01"
baseline = "142 total / 142 passing / 0 failing (re-verified 2026-08-07)"
mirror-check = """
The workflow ALSO re-verifies the schema mirror before validating:
  actual=$(sha256sum schemas/cartridge-v1.json | awk '{print $1}')
  pinned=$(awk -F'\"' '/content_sha256/ {print $2}' schemas/PINNED-SHA)
A mismatch fails the job. Never edit schemas/cartridge-v1.json without
updating schemas/PINNED-SHA in the same commit — and never edit it here at
all if the change belongs upstream in hyperpolymath/standards.
"""

[op-sync-the-shim]
purpose = "Keep the 116 vendored cartridge_shim.zig copies identical to the template."
canonical-source = "cartridges/templates/gossamer-mcp/ffi/cartridge_shim.zig"
current-state = """
NOT AUTOMATED ON MAIN. As of 2026-08-07 there is no sync tool and no CI
check. Recount and compare by hand:

  canon=$(sha256sum cartridges/templates/gossamer-mcp/ffi/cartridge_shim.zig \\
          | awk '{print $1}')
  find cartridges -name cartridge_shim.zig -exec sha256sum {} \\; \\
    | grep -v "^$canon"

Result on commit c2da9ed: 116 copies, 115 match, 1 diverges —
cartridges/domains/gaming/npc-mcp/ffi/cartridge_shim.zig.
"""
pending = "Open PR #109 (feat/zig-016-ffi-sweep) adds tools/sync_cartridge_shim.sh (stamp + --check), Justfile recipes shim-sync / shim-check, and a shim-drift CI job. None of that is on main. Do not write runbook steps that assume it is."
why-vendored = "A fetched cartridge must build standalone in a flat host cache with no sibling paths to reach for, so the shim is copied rather than shared. Drift is the accepted cost; detecting it is the mitigation, and that mitigation is not yet in place."

[op-full-sweep]
purpose = "Build every cartridge, not just the ones a PR touched."
current-state = """
NOT AVAILABLE ON MAIN. .github/workflows/zig-test.yml builds ONLY the
cartridges whose changed paths match '^cartridges/.*/ffi/'. Nothing builds
the whole tree, and nothing builds any adapter at all.

Local approximation of an FFI-only sweep:

  fail=0
  for b in $(find cartridges -path '*/ffi/build.zig'); do
    d=$(dirname "$b")
    ( cd "$d" && zig build test --summary all ) || { echo "FAIL $d"; fail=1; }
  done
  exit $fail

118 ffi/build.zig trees. Expect this to take a long time and to need the
pinned zig (.tool-versions says 0.15.1; zig-test.yml installs 0.15.2 — the
pins disagree on main).
"""
pending = "Open PR #109 adds a `full-sweep` job (weekly cron + workflow_dispatch) that builds every cartridge. Until it merges, 'the sweep' is a manual loop."

[op-run-the-proof-gate]
purpose = "Type-check every Idris2 cartridge ABI and enforce a zero-axiom trusted base."
run = """
  bash scripts/check-trusted-base.sh   # zero believe_me/assert_*/sorry
  bash scripts/typecheck-proofs.sh     # idris2 --check every abi/**/*.idr
"""
workflow = ".github/workflows/proofs.yml (jobs: changes, trusted-base, typecheck)"
toolchain = "idris2 0.8.0 per .tool-versions"
notes = "typecheck-proofs.sh checks each .idr INDIVIDUALLY from its abi/ root rather than building an .ipkg, so a stale .ipkg cannot hide a rotted module. It carries a vacuous-pass guard: PASS=0 is a FAILURE. Respect that guard — it exists because 23 proofs in this repo had silently rotted while their boj-server twins stayed green (#36/#37)."

[incident-response]
steps = """
 1. Read .machine_readable/6a2/STATE.a2ml — [blockers-and-issues] and
    [in-flight] are kept current and honest.
 2. Check whether the failing gate is a HARD gate or an advisory one.
    Hard:     cartridge-schema, proofs (trusted-base + typecheck), governance
    Advisory: hypatia-scan (runs with --exit-zero; findings never fail it)
    Partial:  zig-test (ffi/ paths only; adapters are invisible to CI)
 3. Reproduce locally with the exact command from the relevant [op-*]
    section above. Do not infer the command from the workflow name.
 4. If a check is green but you doubt it, confirm the job actually RAN.
    Several workflows here gate a heavy job behind a `changes` job that
    reports SUCCESS to required checks when skipped.
"""

[release-process]
notes = """
There is no versioned release. This repository is consumed at a git ref.
The nearest equivalent to a release event is a merge to main, after which
hosts fetching via boj-server's scripts/fetch-cartridges.sh pick the change
up on their next fetch. Since hyperpolymath/boj-server#300 merged
(2026-08-04) there is no bundled fallback tree anywhere, so a bad merge to
main reaches every host directly.
"""
pre-merge-checklist = """
 1. cd tools/validate-cartridges && deno task strict
 2. bash scripts/check-trusted-base.sh
 3. bash scripts/typecheck-proofs.sh   (if any .idr changed)
 4. zig build test in each touched cartridge's ffi/
 5. Recount anything you asserted a number about, and update
    .machine_readable/6a2/STATE.a2ml [inventory] if it moved.
"""

[maintenance-operations]
notes = "The RSR maintenance recipes (just maint-audit, just maint-hard-pass, just perms-audit) referenced by the rsr-template-repo playbook are NOT defined in this repo's Justfile. They are listed here only so a reader who goes looking is not confused by their absence."

# ===========================================================================
# ESTATE LANGUAGE POLICY
# ===========================================================================

[banned-language-v]
banned = "V (vlang.io)"
banned-on = "2026-04-10"
scope = "estate-wide"
replacement = "Zig (+ Idris2 for the proof layer, + Rust clients where relevant)"
rationale = """
The Hexadeca-Connector / unified-adapter pattern descends from a retired
V-lang reference implementation (developer-ecosystem/v-ecosystem/
v_api_interfaces/v_api_interfaces.v). Across the estate it was replaced by
the Zig-FFI + Idris2-ABI substrate. In this repository that substrate is
what every cartridge's ffi/ and adapter/ directory implements.
"""
coq-caveat = "Coq theorem files use the same .v extension and are UNAFFECTED. Any V detector must look at content patterns, not the extension."
enforcement-in-this-repo = "NONE. scripts/check-no-vlang.sh does not exist here, and no workflow checks for V. The practical protection is that zero .v files exist under cartridges/ — verified 2026-08-07: `find cartridges -name '*.v' -o -name '*.v.adoc'` returns nothing."
sidelined-file-claim-retracted = """
~140 cartridge READMEs used to document a `SIDELINED-*.v.adoc` file
recording the V predecessor each adapter replaced. ZERO such files exist
under cartridges/, and none appears anywhere in this repository's git
history. The rows documented files that were never here, so they were
removed rather than reworded. .claude/CLAUDE.md still repeats the claim
("Cartridge adapter/ dirs keep a SIDELINED-*.v.adoc note"); that line is
also false and is flagged but not edited by this branch.
"""

# ===========================================================================
# RSR SKELETON CONFORMANCE
# ===========================================================================

[rsr-repo-skeleton]
# The canonical RSR shape is defined and maintained in rsr-template-repo /
# hyperpolymath standards. The previous version of this file reproduced that
# whole specification here as if it described boj-server-cartridges. It does
# not. Rather than restate a spec this repo does not follow, this section
# records only the DELTA, honestly.
skeleton-source = "hyperpolymath/rsr-template-repo (authoritative) — not reproduced here"
conformance = "partial"
conforms = [
  "0-AI-MANIFEST.a2ml at repo root",
  "LICENSE, README.adoc, CHANGELOG.md at root",
  ".machine_readable/ with 6a2/ and contractiles/ (incl. bust/ and dust/)",
  "docs/decisions/ ADRs in .adoc",
  ".github/ with CODEOWNERS, SECURITY.md, workflows/",
  "flake.nix (Nix fallback tier)",
]
does-not-conform = [
  "no AUDIT.adoc",
  "no EXPLAINME.adoc",
  "no coordination.k9",
  "no build/ tree — the Justfile is monolithic, not split into build/just/*.just",
  "no session/ tree",
  "no src/ tree — sources live under cartridges/<...>/{abi,ffi,adapter,panels,tests}",
  "no guix.scm (flake.nix is the only shell)",
  "no .machine_readable/6a2/anchors/",
  "no .machine_readable/self-validating/",
  "docs/echo-types-integration-audit-2026-06-01.md is .md, not .adoc",
  "none of scripts/check-root-shape.sh, check-no-md-in-docs.sh, check-no-vlang.sh, validate-template.sh exists",
  "no .github/workflows/estate-rules.yml",
]
ruling = "These are recorded as facts, not as a work plan. Nothing in this repository currently enforces the RSR skeleton, so an agent should not 'fix' the deltas above without an explicit instruction — several of them (src/, build/) would be actively wrong for a cartridge registry."
