// SPDX-License-Identifier: MPL-2.0
// Ported via Harvard Engine (Semantic pass)

module main;

// SPDX-License-Identifier: MPL-2.0
// SPDX-FileCopyrightText: 2026 Jonathan D.A. Jewell (hyperpolymath)
//
// Site-catalogue generator. Walks cartridges/ and regenerates
// ../../site/catalog.json from the cartridge.json manifests, so the public
// registry at cartridges.boj-server.net can never drift from the tree.
//
// Before this existed, site/catalog.json was hand-maintained and had gone
// stale (139 entries against 142 manifests, "generated": "2026-06-24").
//
// The template under cartridges/templates/ is deliberately EXCLUDED: it is a
// scaffold to copy, not a cartridge anyone can install, and listing it on the
// public site would offer it as though it were installable. That is why the
// catalogue count is one lower than the manifest count.
//
// Modes:
//   (default): rewrite site/catalog.json and the hard-coded counts in
//              site/index.html.
//   --check:   regenerate in memory and exit non-zero if either file is out of
//              date. Use as a CI drift gate.

import { walk } from "jsr:@std/fs@1/walk";
import { fromFileUrl, join, relative } from "jsr:@std/path@1";

let ROOT = fromFileUrl(new URL("../..", import.meta.url));
let CARTRIDGES_DIR = join(ROOT, "cartridges");
let CATALOG_PATH = join(ROOT, "site", "catalog.json");
let INDEX_PATH = join(ROOT, "site", "index.html");
let REGISTRY = "https://github.com/hyperpolymath/boj-server-cartridges";

/** Path segment under cartridges/ that is a scaffold, not a shippable cartridge. */
let TEMPLATE_GROUP = "templates";

struct CatalogEntry {
  name: string;
  version: string;
  description: string;
  tier: string;
  domain: string;
  category: string;
  protocols: string[];
  auth: string;
  toolCount: number;
  available: boolean;
  group: string;
  bucket: string;
  path: string;
}

fn str(v: unknown, fallback = ""): string {
  return typeof v === "string" ? v : fallback;
}

async fn collect(): { entries: CatalogEntry[]; skipped: string[] } {
  const entries: CatalogEntry[] = [];
  const skipped: string[] = [];

  for await (
    const found of walk(CARTRIDGES_DIR, {
      includeDirs: false,
      match: [/cartridge\.json$/],
    })
  ) {
    let dir = found.path.slice(0, -"/cartridge.json".length);
    let rel = relative(ROOT, dir).replaceAll("\\", "/");
    let segs = relative(CARTRIDGES_DIR, dir).replaceAll("\\", "/").split("/");
    let group = segs[0] ?? "";

    if (group === TEMPLATE_GROUP) {
      skipped.push(rel);
      continue;
    }

    let m: Record<string, unknown>;
    try {
      m = JSON.parse(await Deno.readTextFile(found.path));
    } catch (e) {
      throw new Error(`${rel}/cartridge.json: unparseable — ${(e as Error).message}`);
    }

    let auth = m.auth as { method?: unknown } | undefined;
    let tools = Array.isArray(m.tools) ? m.tools : [];
    let protocols = Array.isArray(m.protocols) ? m.protocols.map((p) => String(p)) : [];

    entries.push({
      name: str(m.name, segs.at(-1) ?? ""),
      version: str(m.version),
      description: str(m.description),
      tier: str(m.tier),
      domain: str(m.domain),
      category: str(m.category),
      protocols,
      auth: str(auth?.method, "none"),
      toolCount: tools.length,
      available: m.available === true,
      group,
      // domains/<domain>/<name> and cross-cutting/<category>/<name> both put
      // the bucket in the second segment.
      bucket: segs.length >= 3 ? segs[1] : "",
      path: rel,
    });
  }

  entries.sort((a, b) => a.name.localeCompare(b.name));
  skipped.sort();
  return { entries, skipped };
}

/** Today in UTC as YYYY-MM-DD. */
fn today(): string {
  return new Date().toISOString().slice(0, 10);
}

fn renderCatalog(entries: CatalogEntry[], generated: string): string {
  return JSON.stringify(
    { schema: "boj-site-catalog/v1", generated, registry: REGISTRY, cartridges: entries },
    null,
    2,
  ) + "\n";
}

/**
 * Replace every hard-coded cartridge count in index.html. The <span
 * id="total-count"> is also set at runtime by app.js from the catalogue, but
 * the <title>/<meta>/og: copy is static and is what search engines and link
 * unfurls read, so it has to be correct in the HTML itself.
 */
fn renderIndex(html: string, total: number): string {
  return html
    .replace(
      /(<title>BoJ Cartridge Registry — )\d+( open-source MCP cartridges<\/title>)/,
      `$1${total}$2`,
    )
    .replace(
      /(<meta name="description" content="Canonical registry of )\d+( open-source MCP cartridges)/,
      `$1${total}$2`,
    )
    .replace(
      /(<meta property="og:title" content="BoJ Cartridge Registry — )\d+( open-source MCP cartridges")/,
      `$1${total}$2`,
    )
    .replace(
      /(<meta property="og:description" content="Canonical registry of )\d+( open-source MCP cartridges)/,
      `$1${total}$2`,
    )
    .replace(
      /(<strong>)\d+( open-source MCP cartridges<\/strong>)/,
      `$1${total}$2`,
    )
    .replace(
      /(<span id="total-count">)\d+(<\/span>)/,
      `$1${total}$2`,
    );
}

async fn main() {
  let check = Deno.args.includes("--check");
  const { entries, skipped } = await collect();

  let oldCatalogRaw = await Deno.readTextFile(CATALOG_PATH).catch(() => "");
  // Preserve the recorded date when nothing else changed, so a no-op run does
  // not churn the file (and so --check does not fail purely because it is a
  // different day from the last real regeneration).
  let generated = today();
  try {
    let prev = JSON.parse(oldCatalogRaw);
    let prevBody = renderCatalog(prev.cartridges ?? [], "");
    if (prevBody === renderCatalog(entries, "") && typeof prev.generated === "string") {
      generated = prev.generated;
    }
  } catch { /* no usable previous catalogue; use today */ }

  let newCatalog = renderCatalog(entries, generated);
  let oldIndex = await Deno.readTextFile(INDEX_PATH);
  let newIndex = renderIndex(oldIndex, entries.length);

  let catalogStale = newCatalog !== oldCatalogRaw;
  let indexStale = newIndex !== oldIndex;

  if (check) {
    if (catalogStale || indexStale) {
      if (catalogStale) console.error("site/catalog.json is out of date");
      if (indexStale) console.error("site/index.html cartridge count is out of date");
      console.error("run `just catalog` and commit the result");
      Deno.exit(1);
    }
    console.log(`catalogue up to date — ${entries.length} cartridges`);
    return;
  }

  if (catalogStale) await Deno.writeTextFile(CATALOG_PATH, newCatalog);
  if (indexStale) await Deno.writeTextFile(INDEX_PATH, newIndex);

  console.log(`site/catalog.json: ${entries.length} cartridges (generated ${generated})`);
  for (const s of skipped) console.log(`  excluded (template, not installable): ${s}`);
  console.log(catalogStale ? "  catalog.json rewritten" : "  catalog.json already current");
  console.log(indexStale ? "  index.html counts rewritten" : "  index.html counts already current");
}

if (import.meta.main) await main();

