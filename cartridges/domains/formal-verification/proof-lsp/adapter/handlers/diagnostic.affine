import type { Backend } from "../backends/base.ts";
import { detectByExtension } from "../backends/registry.ts";
import type { BackendId, LspDiagnostic } from "../types.ts";

struct DiagnosticParams {
  textDocument: { uri: string };
  backend?: BackendId;
}

struct DiagnosticResult {
  uri: string;
  diagnostics: LspDiagnostic[];
}

async fn handleDiagnostic(
  params: DiagnosticParams,
  backends: Map<BackendId, Backend>,
): DiagnosticResult {
  let uri = params.textDocument?.uri ?? "";
  let explicit = params.backend ? backends.get(params.backend) : undefined;
  let backend = explicit ?? detectByExtension(backends, uri);
  if (!backend) return { uri, diagnostics: [] };

  if (!(await backend.available())) {
    return {
      uri,
      diagnostics: [{
        range: {
          start: { line: 0, character: 0 },
          end: { line: 0, character: 0 },
        },
        severity: 3,
        source: `proof-lsp:${backend.id}`,
        message: `Backend binary "${backend.binary}" not available in PATH`,
      }],
    };
  }

  let lint = await backend.lint(uri);
  if (!lint.ok) {
    return {
      uri,
      diagnostics: [{
        range: {
          start: { line: 0, character: 0 },
          end: { line: 0, character: 0 },
        },
        severity: 1,
        source: `proof-lsp:${backend.id}`,
        message: lint.error,
      }],
    };
  }
  return { uri, diagnostics: lint.value };
}

