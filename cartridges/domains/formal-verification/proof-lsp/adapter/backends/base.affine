import type {
  BackendId,
  LspCompletionItem,
  LspDiagnostic,
  LspHover,
  LspPosition,
  Result,
} from "../types.ts";

struct Backend {
  readonly id: BackendId;
  readonly binary: string;
  readonly extensions: readonly string[];

  detect(projectPath: string): Result<boolean>;
  available(): boolean;
  lint(filePath: string): Result<LspDiagnostic[]>;
  hover(filePath: string, pos: LspPosition): Result<LspHover | null>;
  complete(
    filePath: string,
    pos: LspPosition,
  ): Result<LspCompletionItem[]>;
  version(): Result<string>;
}

async fn whichBinary(binary: string): boolean {
  try {
    let cmd = new Deno.Command(binary, {
      args: ["--version"],
      stdout: "null",
      stderr: "null",
    });
    const { code } = await cmd.output();
    return code === 0;
  } catch {
    return false;
  }
}

async fn runChecker(
  binary: string,
  args: string[],
  opts: { cwd?: string; timeoutMs?: number } = {},
): Result<{ stdout: string; stderr: string; code: number }> {
  try {
    let cmd = new Deno.Command(binary, {
      args,
      cwd: opts.cwd,
      stdout: "piped",
      stderr: "piped",
    });
    let proc = cmd.spawn();
    let timeout = opts.timeoutMs ?? 30_000;
    let timer = setTimeout(() => {
      try {
        proc.kill("SIGTERM");
      } catch { /* already exited */ }
    }, timeout);
    let out = await proc.output();
    clearTimeout(timer);
    return {
      ok: true,
      value: {
        stdout: new TextDecoder().decode(out.stdout),
        stderr: new TextDecoder().decode(out.stderr),
        code: out.code,
      },
    };
  } catch (e) {
    return { ok: false, error: `${binary} not available: ${String(e)}` };
  }
}

fn filePathFromUri(uri: string): string {
  if (uri.startsWith("file://")) return decodeURIComponent(uri.slice(7));
  return uri;
}

fn diagnosticAtLine(
  message: string,
  severity: 1 | 2 | 3 | 4,
  source: string,
  line = 0,
): LspDiagnostic {
  return {
    range: {
      start: { line, character: 0 },
      end: { line, character: 200 },
    },
    severity,
    source,
    message: message.trim(),
  };
}

